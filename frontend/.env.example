# 실제 값은 .env.local 에 넣는다. .env* 는 git에서 제외된다 (이 예시 파일만 예외).

# 백엔드 API 프록시 대상. 비워 두면 /api rewrites를 걸지 않는다.
# 예: http://localhost:8080
API_PROXY_TARGET=

# 배포된 사이트 주소. OG 이미지·선물 링크 절대 경로 생성에 쓴다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 관측 (Phase 1에서 연결)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 카카오 JS SDK (공유용, Phase 4~5)
NEXT_PUBLIC_KAKAO_JS_KEY=
