{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sajuppugi.com/schemas/liner-response-v1.json",
  "title": "Liner reading response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections", "omittedSections"],
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "content", "sourceFactKeys"],
        "properties": {
          "key": { "type": "string" },
          "content": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "sourceFactKeys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "omittedSections": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
