# Local Docker Compose database only. These are not production credentials.
DB_USERNAME=sajuppugi
DB_PASSWORD=local-development-only
DB_NAME=sajuppugi
DB_PORT=5432

# Copy this file to .env for local runs; shared environments use process environment variables.
DB_URL=jdbc:postgresql://localhost:5432/sajuppugi
SPRING_PROFILES_ACTIVE=local
PORT=8080

# Kakao OAuth. Register this exact callback URI in Kakao Developers.  In staging,
# use the fixed frontend origin because Next.js proxies /api/v1 to this server.
# Do not put either server-side credential in frontend environment variables.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/v1/auth/kakao/callback
FRONTEND_BASE_URL=http://localhost:3000
KAKAO_SESSION_TTL=30d
KAKAO_STATE_TTL=10m
# A new login is retained; if this limit is exceeded, the least-recently-used
# older sessions are revoked inside the same short database transaction.
KAKAO_MAX_ACTIVE_SESSIONS=5

# Toss test adapter only. Live keys and production activation are intentionally rejected.
TOSS_ADAPTER=disabled
TOSS_SECRET_KEY=
TOSS_CONNECT_TIMEOUT=3s
TOSS_READ_TIMEOUT=10s
# Enable only with the test adapter configured; bounded recovery queries existing orders.
TOSS_RECOVERY_ENABLED=false

# Reading purchases stay disabled locally until the wallet/recovery flow is
# intentionally exercised against the isolated PostgreSQL test database.
WALLET_PURCHASES_ENABLED=false
WALLET_RECOVERY_ENABLED=false
READING_GENERATION_RECOVERY_ENABLED=false

# Gift drafts/purchases are local/test only until content, delivery and retention are ready.
# A separate 32-byte Base64 encryption key is required; never use the Toss secret key here.
GIFT_ORDERS_ENABLED=false
GIFT_PURCHASES_ENABLED=false
GIFT_RECOVERY_ENABLED=false
GIFT_PAYLOAD_KEY=

# Liner Responses API (never commit a real key).
LINER_API_KEY=
LINER_MODEL=liner-mark
LINER_BASE_URL=https://platform.liner.com/api/v1
LINER_CONNECT_TIMEOUT=3s
LINER_READ_TIMEOUT=30s
LINER_MAX_OUTPUT_TOKENS=4000
LINER_REASONING_EFFORT=low
