option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: '5000'
    SPRING_PROFILES_ACTIVE: staging,prelaunch
    TOSS_ADAPTER: disabled
    TOSS_RECOVERY_ENABLED: 'false'
    TOSS_REFUNDS_ENABLED: 'false'
    TOSS_WEBHOOKS_ENABLED: 'false'
    TOSS_OPERATIONS_ENABLED: 'false'
    WALLET_PURCHASES_ENABLED: 'false'
    WALLET_RECOVERY_ENABLED: 'false'
    WALLET_OPERATIONS_ENABLED: 'false'
    GIFT_ORDERS_ENABLED: 'false'
    GIFT_PURCHASES_ENABLED: 'false'
    GIFT_RECOVERY_ENABLED: 'false'
    ADMIN_OPERATIONS_ENABLED: 'false'
    ADMIN_RECOVERY_ENABLED: 'false'
    READING_GENERATION_RECOVERY_ENABLED: 'false'
    TALISMAN_RENDER_ENABLED: 'false'
    LINER_ADAPTER: api
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /actuator/health/readiness
    MatcherHTTPCode: '200'
